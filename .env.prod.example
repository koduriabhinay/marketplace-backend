# Production settings, kept only on the server as ~/marketplace/.env.prod (git-ignored).
# scripts/deploy.sh creates this file on the first deploy and fills in random passwords,
# so you normally never write it by hand.

# The public name of the site, e.g. myshop.duckdns.org or shop.example.com
DOMAIN=
# Let's Encrypt emails you here if a certificate is about to expire.
LETSENCRYPT_EMAIL=

# Where CI publishes the images (lowercase). The tag is chosen per deploy.
IMAGE_REPO=ghcr.io/OWNER/marketplace-backend

# Passwords: letters and digits only (they are used inside connection URLs).
POSTGRES_PASSWORD=
REPLICATION_PASSWORD=
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Nginx listens on the standard ports in production.
HTTP_PORT=80
HTTPS_PORT=443
# Tells browsers "HTTPS only" for this many seconds. Start small; once everything works,
# raise it to 63072000 (two years).
HSTS_MAX_AGE=3600
