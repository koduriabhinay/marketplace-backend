{
  "name": "marketplace-backend",
  "version": "0.1.0",
  "description": "Production-style Node.js + TypeScript marketplace backend (learning project)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "check:full": "REQUIRE_ALL_SERVICES=1 TEST_REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} TEST_RABBITMQ_URL=${TEST_RABBITMQ_URL:-amqp://guest:guest@localhost:5672} npm run check",
    "migrate": "tsx src/db/migrateCli.ts",
    "migrate:prod": "node dist/db/migrateCli.js",
    "db:up": "docker compose up -d postgres",
    "db:backup": "./scripts/backup.sh",
    "db:restore": "./scripts/restore.sh",
    "create-admin": "tsx src/auth/createAdminCli.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "amqplib": "^2.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
